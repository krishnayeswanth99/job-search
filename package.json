{
  "name": "job-search",
  "version": "0.3.0",
  "private": true,
  "description": "Job Copilot Chrome extension + Claude skills for finding, tailoring and applying to jobs.",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "sync-shared": "node scripts/sync-shared.mjs",
    "check": "node scripts/sync-shared.mjs --check && npm run test:unit",
    "package:extension": "node scripts/package-extension.mjs",
    "vendor:sdk": "node scripts/vendor-anthropic-sdk.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
