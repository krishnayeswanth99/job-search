{
  "manifest_version": 3,
  "name": "Job Copilot",
  "version": "0.5.0",
  "description": "Finds jobs on the current tab, autofills applications, and gives Claude in Chrome a bridge to do the same.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "Job Copilot",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/page/page-api.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/shared/config.js",
        "src/shared/profile-schema.js",
        "src/shared/field-rules.js",
        "src/content/util.js",
        "src/content/jsonld.js",
        "src/content/login.js",
        "src/content/navigation.js",
        "src/content/extractors.js",
        "src/content/fields.js",
        "src/content/autofill.js",
        "src/content/memory.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
